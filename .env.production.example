# Production-oriented Docker Compose variable template.
# Copy this to a protected, untracked server-only environment file. The
# deployment runbook uses /opt/konkourix/config/production.env.

# PostgreSQL initialization and API connection. Keep the password values aligned;
# URL-encode reserved characters in DATABASE_URL.
POSTGRES_DB=konkourx
POSTGRES_USER=konkourx
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DATABASE_URL=postgresql://konkourx:replace-with-a-url-encoded-strong-random-password@postgres:5432/konkourx

# Intended public HTTPS origins. These values describe the routing contract;
# they do not imply that DNS or TLS is active.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
API_URL=https://api.konkourix.ir
STUDENT_APP_URL=https://app.konkourix.ir
COUNSELOR_APP_URL=https://counselor.konkourix.ir
CORS_ORIGINS=https://app.konkourix.ir,https://counselor.konkourix.ir

# The API-only refresh cookie should remain host-only unless deployment requires
# an explicit domain. Proxy trust remains off until a controlled ingress exists.
COOKIE_DOMAIN=
TRUST_PROXY=false

# Runtime authentication configuration. ACCESS_TOKEN_SECRET is the API's
# current JWT signing secret; refresh tokens are random session tokens and do
# not use a second JWT secret. Never commit deployed values.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ACCESS_TOKEN_ISSUER=konkourx-api
ACCESS_TOKEN_AUDIENCE=konkourx-client

# Public Vite build configuration; this is embedded in both frontend bundles.
VITE_API_URL=https://api.konkourix.ir

# Reserved for a future upload subsystem. The current API does not consume this
# variable and Compose does not mount upload storage yet.
UPLOAD_PATH=/app/uploads
