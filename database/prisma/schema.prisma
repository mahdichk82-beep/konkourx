generator client {
  provider            = "prisma-client"
  output              = "../../apps/api/src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  COUNSELOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                         AuthSession[]
  studentProfile                   StudentProfile?
  counselorProfile                 CounselorProfile?
  studentRelationships             StudentCounselor[]           @relation("StudentCounselorStudent")
  counselorRelationships           StudentCounselor[]           @relation("StudentCounselorCounselor")
  createdDailyTasks                DailyTask[]                  @relation("DailyTaskCreator")

  @@map("users")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique
  familyId  String @db.Uuid

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

enum StudentCounselorStatus {
  ACTIVE
  INACTIVE
}

model StudentProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  educationLevel String?
  schoolName     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  studySubjects      StudySubject[]
  studyPlans         StudyPlan[]
  dailyTasks         DailyTask[]
  studySessions      StudySession[]
  assessmentAttempts AssessmentAttempt[]
  goals              StudentGoal[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model CounselorProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @db.Uuid
  bio            String?
  specialization String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("counselor_profiles")
}

model StudentCounselor {
  id          String                 @id @default(uuid()) @db.Uuid
  studentId   String                 @db.Uuid
  counselorId String                 @db.Uuid
  status      StudentCounselorStatus @default(ACTIVE)
  startedAt   DateTime               @default(now())
  endedAt     DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  student   User @relation("StudentCounselorStudent", fields: [studentId], references: [id], onDelete: Cascade)
  counselor User @relation("StudentCounselorCounselor", fields: [counselorId], references: [id], onDelete: Cascade)

  @@unique([studentId, counselorId])
  @@index([studentId])
  @@index([counselorId])
  @@index([status])
  @@map("student_counselor_relationships")
}

enum StudyPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum DailyTaskStatus {
  PENDING
  COMPLETED
  PARTIAL
  SKIPPED
}

enum DailyTaskSource {
  PERSONAL
  COUNSELOR
}

enum DailyTaskSkipReason {
  NO_TIME
  TOO_DIFFICULT
  FORGOT
  OTHER
}

enum CurriculumReferenceKind {
  NODE
  PLACEMENT
}

enum CurriculumSelectionMode {
  EXACT
  WHOLE
}

model StudySubject {
  id               String    @id @default(uuid()) @db.Uuid
  studentProfileId String    @db.Uuid
  name             String
  normalizedName   String
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile           StudentProfile            @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  dailyTasks               DailyTask[]
  studySessions            StudySession[]
  assessmentAttempts       AssessmentAttempt[]
  goals                    StudentGoal[]
  topics                   Topic[]

  @@unique([studentProfileId, normalizedName])
  @@index([studentProfileId, archivedAt])
  @@map("study_subjects")
}

model Topic {
  id              String    @id @default(uuid()) @db.Uuid
  subjectId       String    @db.Uuid
  title           String
  normalizedTitle String
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subject                  StudySubject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dailyTasks               DailyTask[]
  assessmentAttempts       AssessmentAttempt[]

  @@unique([subjectId, normalizedTitle])
  @@index([subjectId])
  @@map("study_topics")
}

model StudyPlan {
  id               String          @id @default(uuid()) @db.Uuid
  studentProfileId String          @db.Uuid
  title            String
  description      String?
  status           StudyPlanStatus @default(DRAFT)
  startsOn         DateTime        @db.Date
  endsOn           DateTime?       @db.Date
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  dailyTasks     DailyTask[]

  @@index([studentProfileId, status])
  @@index([studentProfileId, startsOn, endsOn])
  @@map("study_plans")
}

model DailyTask {
  id               String               @id @default(uuid()) @db.Uuid
  studentProfileId String               @db.Uuid
  createdByUserId  String               @db.Uuid
  source           DailyTaskSource
  studyPlanId      String?              @db.Uuid
  subjectId        String?              @db.Uuid
  topicId          String?              @db.Uuid
  title            String
  description      String?
  scheduledFor     DateTime             @db.Date
  estimatedMinutes Int?
  plannedTestCount Int                  @default(0)
  status           DailyTaskStatus      @default(PENDING)
  completedAt      DateTime?
  partialAt        DateTime?
  skipReason       DailyTaskSkipReason?
  skippedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  studentProfile     StudentProfile              @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  createdBy          User                        @relation("DailyTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  studyPlan          StudyPlan?                  @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)
  subject            StudySubject?               @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic              Topic?                      @relation(fields: [topicId], references: [id], onDelete: SetNull)
  studySessions      StudySession[]
  assessmentAttempts AssessmentAttempt[]
  curriculumTargets  DailyTaskCurriculumTarget[]
  curriculumItems    DailyTaskCurriculumItem[]

  @@index([studentProfileId, scheduledFor])
  @@index([studentProfileId, status, scheduledFor])
  @@index([createdByUserId])
  @@index([studyPlanId])
  @@index([subjectId])
  @@index([topicId])
  @@map("daily_tasks")
}

model DailyTaskCurriculumTarget {
  id                       String                  @id @default(uuid()) @db.Uuid
  dailyTaskId              String                  @db.Uuid
  referenceKind            CurriculumReferenceKind
  curriculumRefId          String
  selectionMode            CurriculumSelectionMode
  position                 Int
  labelSnapshot            String
  pathSnapshot             String[]
  representationIdSnapshot String?
  createdAt                DateTime                @default(now())

  dailyTask DailyTask                 @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  items     DailyTaskCurriculumItem[]

  @@unique([dailyTaskId, position])
  @@index([dailyTaskId])
  @@map("daily_task_curriculum_targets")
}

model DailyTaskCurriculumItem {
  id              String                  @id @default(uuid()) @db.Uuid
  targetId        String                  @db.Uuid
  dailyTaskId     String                  @db.Uuid
  referenceKind   CurriculumReferenceKind
  curriculumRefId String
  labelSnapshot   String
  pathSnapshot    String[]
  position        Int
  completedAt     DateTime?
  createdAt       DateTime                @default(now())

  target    DailyTaskCurriculumTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  dailyTask DailyTask                 @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)

  @@unique([dailyTaskId, position])
  @@unique([dailyTaskId, referenceKind, curriculumRefId])
  @@index([targetId, position])
  @@index([dailyTaskId, completedAt])
  @@map("daily_task_curriculum_items")
}

model StudySession {
  id                 String    @id @default(uuid()) @db.Uuid
  studentProfileId   String    @db.Uuid
  subjectId          String?   @db.Uuid
  dailyTaskId        String?   @db.Uuid
  startedAt          DateTime
  endedAt            DateTime?
  cancelledAt        DateTime?
  focusRating        Int?
  studyQualityRating Int?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        StudySubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  dailyTask      DailyTask?     @relation(fields: [dailyTaskId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, startedAt])
  @@index([studentProfileId, subjectId, startedAt])
  @@index([dailyTaskId])
  @@map("study_sessions")
}

model AssessmentAttempt {
  id               String    @id @default(uuid()) @db.Uuid
  studentProfileId String    @db.Uuid
  dailyTaskId      String?   @db.Uuid
  subjectId        String?   @db.Uuid
  topicId          String?   @db.Uuid
  title            String
  startedAt        DateTime
  endedAt          DateTime
  correctCount     Int
  incorrectCount   Int
  blankCount       Int
  invalidatedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  dailyTask      DailyTask?     @relation(fields: [dailyTaskId], references: [id], onDelete: SetNull)
  subject        StudySubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic          Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, endedAt])
  @@index([dailyTaskId])
  @@index([subjectId, endedAt])
  @@index([topicId, endedAt])
  @@map("assessment_attempts")
}

enum StudentGoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model StudentGoal {
  id               String            @id @default(uuid()) @db.Uuid
  studentProfileId String            @db.Uuid
  subjectId        String?           @db.Uuid
  title            String
  description      String?
  targetDate       DateTime?         @db.Date
  status           StudentGoalStatus @default(ACTIVE)
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  subject        StudySubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([studentProfileId, status])
  @@index([studentProfileId, targetDate])
  @@index([subjectId])
  @@map("student_goals")
}
